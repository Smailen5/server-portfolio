# Configurazione Server
# Ambiente di esecuzione: `development` o `production` - (obbligatoria)
NODE_ENV=development
# Porta del server (default: 3000) - (facoltativa)
PORT=3000

# Configurazione GitHub
# Token GitHub per evitare rate limiter API (repo pubbliche) - (obbligatoria)
# Genera un token su: https://github.com/settings/tokens
GITHUB_TOKEN=il-tuo-token

# Configurazione Database
# Stringa di connessione MongoDB - (obbligatoria)
DB_CONNECTION=mongodb://localhost:27017/nome-database

# Configurazione Sicurezza
# Dominio produzione per CORS - (obbligatoria in produzione, facoltativa in sviluppo)
CORS_ORIGIN=https://tuo-dominio.com
# Dominio sviluppo per CORS (localhost frontend) - (facoltativa)
# Serve solo in sviluppo per permettere richieste da http://localhost:5173
CORS_DEV_ORIGIN=http://localhost:5173
# Chiave API per autenticazione richieste esterne - (obbligatoria)
SERVER_API_KEY=la-tua-api-key
# Segreto per firmare i token JWT - (obbligatoria)
JWT_SECRET=il-tuo-secret-jwt

# Configurazione Logging
# Livello log: error, warn, info, debug (default: info) - (facoltativa)
LOG_LEVEL=info
# Percorso file log applicazioni (default: logs/app.log) - (facoltativa)
LOG_FILE_PATH=logs/app.log
# Percorso file log errori (default: logs/error.log) - (facoltativa)
ERROR_LOG_FILE_PATH=logs/error.log

# Configurazione rate limiter
# Finestra temporale in millisecondi (default: 900000 = 15 min) - (facoltativa)
RATE_LIMIT_WINDOW_MS=900000
# Max richieste per finestra (default: 100) - (facoltativa)
RATE_LIMIT_MAX=100

# Configurazione Admin
# Email admin per creazione utente iniziale - (obbligatoria)
ADMIN_EMAIL=admin@example.com
# Password admin per creazione utente iniziale - (obbligatoria)
ADMIN_PASSWORD=la-tua-password-admin

# Configurazione Progetti
# Prefissi repo GitHub da sincronizzare (default: fm-) - (facoltativa)
# Esempio: fm-,pm- per sincronizzare repo che iniziano con fm- o pm-
PROJECT_PREFIXES=fm-
# Directory per salvare screenshots (default: ./public/screenshots) - (facoltativa)
SCREENSHOTS_DIR=./public/screenshots

# Sincronizzazione automatica GitHub
# Cron expression per sync automatica (default: 0 * * * * = ogni ora) - (facoltativa)
SYNC_CRON=0 * * * *
